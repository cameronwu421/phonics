# ─── Stage 1: Builder ─────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Copy root workspace manifests for npm workspaces
COPY package.json package-lock.json* ./
COPY packages/shared/package.json ./packages/shared/
COPY services/api/package.json ./services/api/

# Install ALL dependencies (root + workspaces, including devDeps)
RUN npm ci

# Copy source files
COPY tsconfig.base.json ./
COPY packages/shared/ ./packages/shared/
COPY services/api/ ./services/api/

# Build shared types first, then API
RUN cd packages/shared && npm run build
RUN cd services/api && npm run build

# ─── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM node:22-alpine AS runtime

# Security: run as non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

# Copy root manifests
COPY package.json package-lock.json* ./
COPY packages/shared/package.json ./packages/shared/
COPY services/api/package.json ./services/api/

# Install production dependencies only (entire tree, but no devDeps)
RUN npm ci --omit=dev --omit=optional

# Copy compiled output from builder
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/services/api/dist ./services/api/dist

USER appuser

# Health check: Docker will poll every 30s after 10s startup grace
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:3001/health || exit 1

EXPOSE 3001

CMD ["node", "services/api/dist/index.js"]
